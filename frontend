<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Management System</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f4f6f9;
        }

        /* Header */
        header {
            background-color: #1e3a5f;
            color: white;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            font-size: 30px;
            margin-bottom: 5px;
        }

        header p {
            font-size: 15px;
        }

        /* Main Container */
        .container {
            width: 90%;
            max-width: 1100px;
            margin: 30px auto;
        }

        /* Form Section */
        .form-section {
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

        .form-section h2 {
            color: #1e3a5f;
            margin-bottom: 20px;
        }

        .form-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 15px;
        }

        .add-btn {
            margin-top: 20px;
            padding: 12px 25px;
            background-color: #1e3a5f;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 15px;
        }

        .add-btn:hover {
            background-color: #142940;
        }

        /* Search Section */
        .search-section {
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 25px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .search-section h2 {
            color: #1e3a5f;
            margin-bottom: 15px;
        }

        .search-section input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 15px;
        }

        /* Student Table */
        .table-section {
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
            overflow-x: auto;
        }

        .table-section h2 {
            color: #1e3a5f;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: #1e3a5f;
            color: white;
            padding: 14px;
        }

        td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }

        .edit-btn {
            background-color: #f0ad4e;
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 4px;
        }

        .delete-btn {
            background-color: #d9534f;
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 4px;
        }

        /* Footer */
        footer {
            margin-top: 30px;
            background-color: #1e3a5f;
            color: white;
            text-align: center;
            padding: 15px;
        }

        /* Responsive Design */
        @media (max-width: 700px) {

            .form-group {
                grid-template-columns: 1fr;
            }

            header h1 {
                font-size: 24px;
            }

            th,
            td {
                font-size: 12px;
                padding: 8px;
            }
        }
    </style>
</head>

<body>

